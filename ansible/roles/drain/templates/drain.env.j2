# Rendered 0600 by Ansible (no_log). Sourced by drain.sh.
# NOTE: this puts the Cloudflare API token on the box (tailnet-only, 0600). Consider a token scoped
# to ONLY "Load Balancing: Monitors and Pools — Edit" if you want to narrow it.
CF_TOKEN={{ vault_cloudflare_api_token }}
CF_ACCOUNT={{ drain_cf_account_id }}
CF_POOL_NAME={{ drain_cf_pool_name }}
MY_ORIGIN={{ drain_identity.mine }}
OTHER_ORIGIN={{ drain_identity.other }}
MY_PATRONI={{ drain_identity.mine }}
OTHER_PATRONI={{ drain_identity.other }}
# The nightly pg_dump's advisory lock. The reboot path hands off the Patroni leader, which truncates
# an in-flight dump into an object that still looks like a good backup — so the reboot gates skip
# their window while this is held. Must match roles/postgres_ha pg_ha_backup_lock.
BACKUP_LOCK={{ drain_backup_lock }}
