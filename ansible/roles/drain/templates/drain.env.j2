# Rendered 0600 by Ansible (no_log). Sourced by drain.sh.
#
# Draining is LOCAL: stop this box's cloudflared connector and its registrations drop off the app
# tunnel, so Cloudflare routes clip.cool + id.clip.cool to the peer's connector. The Cloudflare API
# below is only used to OBSERVE that — "have my connections gone?", "does the peer still have any?" —
# so an empty or dead CF_TOKEN degrades those checks (fixed settle wait + the Patroni peer check)
# without ever blocking the drain. That is the point of the 2026-07-30 rewrite: the old LB-based
# version could not drain AT ALL once its API call started failing, because the API call *was* the
# drain. Here the API is only the witness.
#
# ⚠️ LEAST-PRIVILEGE GAP (open): this puts a Cloudflare API token on the box (tailnet-only, 0600).
# Nothing here writes to Cloudflare any more, so READ on Account -> Cloudflare Tunnel is all drain.sh
# needs — but `vault_cloudflare_api_token` is the shared account token, which can edit DNS and delete
# load balancers in every zone on the account (including the AMS sites). Mint a read-only tunnel token
# and point drain_cf_token at it; drain.sh needs no code change, and a compromised box then cannot
# touch anything. Until then, assume this box holds account-wide Cloudflare write.
CF_TOKEN={{ drain_cf_token }}
CF_ACCOUNT={{ drain_cf_account_id }}
CF_TUNNEL_NAME={{ drain_cf_tunnel_name }}
MY_ORIGIN={{ drain_identity.mine }}
OTHER_ORIGIN={{ drain_identity.other }}
MY_PATRONI={{ drain_identity.mine }}
OTHER_PATRONI={{ drain_identity.other }}
# Egress IPs — how a connector identifies itself in the tunnel API (`origin_ip`).
MY_PUBLIC_IP={{ public_ip }}
OTHER_PUBLIC_IP={{ hostvars[drain_identity.other_host].public_ip }}
# The connector stack. drain.sh stops the `cloudflared` SERVICE only — never `cloudflared-chat`, which
# has no peer connector to fail over to.
CLOUDFLARED_COMPOSE={{ drain_cloudflared_compose }}
CFD_STOP_TIMEOUT={{ drain_connector_stop_timeout }}
CFD_SETTLE={{ drain_connector_settle }}
# The HA-Postgres stack (roles/postgres_ha). Templated, never hardcoded in drain.sh, so the etcd client
# port tracks that role instead of drifting.
PGHA_COMPOSE={{ drain_pgha_compose }}
ETCD_CLIENT_PORT={{ drain_etcd_client_port }}
# The nightly pg_dump's advisory lock. The reboot path hands off the Patroni leader, which truncates an
# in-flight dump into an object that still looks like a good backup — so the reboot gates skip their
# window while this is held. Must match roles/postgres_ha pg_ha_backup_lock.
BACKUP_LOCK={{ drain_backup_lock }}
# Local readiness gate for `undrain`.
READYZ_HOST={{ drain_readyz_host }}
READYZ_URL={{ drain_readyz_url }}
