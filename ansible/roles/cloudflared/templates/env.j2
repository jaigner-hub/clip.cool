# Rendered 0600 by Ansible (no_log). cloudflared tunnel run tokens (SOPS-sourced).
# APP = the shared clip.cool/id.clip.cool tunnel (same token on both boxes — that is what makes it one
# tunnel with two connectors). CHAT = the vent.dog-only chat/livekit tunnel; empty on vent.dog2, where
# the compose template renders no chat service to consume it.
CLOUDFLARED_APP_TOKEN={{ cloudflared_app_token }}
CLOUDFLARED_CHAT_TOKEN={{ cloudflared_chat_token | default('') }}
